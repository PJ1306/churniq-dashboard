modules = ["python-3.11"]

[nix]
channel = "stable-23_11"

run = "bash -c 'export LD_LIBRARY_PATH=\"$(dirname \"$(gcc -print-file-name=libgomp.so.1)\")${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\" && exec streamlit run app.py --server.port 5000 --server.address 0.0.0.0'"

[deployment]
run = ["bash", "-c", "export LD_LIBRARY_PATH=\"$(dirname \"$(gcc -print-file-name=libgomp.so.1)\")${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\" && exec streamlit run app.py --server.port 5000 --server.address 0.0.0.0"]

[[ports]]
localPort = 5000
externalPort = 80
